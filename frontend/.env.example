# Public, build-time values (Vite inlines VITE_* into the bundle — never put a secret here).
# Supabase → Project Settings → API. Use the *publishable / anon* key; NEVER the service_role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Leave empty to call the API on the same origin (/api — proxied by Vercel rewrites or nginx). Set it to the API's
# origin (e.g. https://api.example.com) if you'd rather call it directly; then add the frontend origin to the API's CORS_ORIGINS.
VITE_API_URL=
