# Copy to .env (never commit .env). Every value here is read by app/core/config.py.
NIRMAAN_ENV=development                 # development | test | production (production refuses unsafe config)

# ── Database: your Supabase Postgres ────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string (use the *pooler* URI, port 6543, for serverless hosts).
# Locally: postgresql:///nirmaan_dev  (see supabase/local/reset.sh)
DATABASE_URL=postgresql:///nirmaan_dev

# ── Supabase Auth: the API only VERIFIES tokens ─────────────────────────────────────────────
# Supabase → Project Settings → API → Project URL. Asymmetric (JWKS) projects need only this.
SUPABASE_URL=
# Only for legacy HS256 projects (Project Settings → API → JWT Secret) and the automated tests. Leave empty otherwise.
SUPABASE_JWT_SECRET=

# ── HTTP ────────────────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173      # comma separated; must be the real frontend origin(s) in production
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_PER_MINUTE=240
SESSION_CACHE_SECONDS=10                # a signed-out token stays valid for at most this long (0 = check the database every request)

# ── Scheduled jobs (alerts, reminders, freshness) ───────────────────────────────────────────
CRON_SECRET=                            # long random string; an external cron calls POST /api/internal/jobs/{sql|alerts|ingest}
SCHEDULER_ENABLED=false                 # true = run jobs inside this process (single instance only)

# ── Optional Google Calendar / Gmail (NOT login; Google login is configured inside Supabase Auth) ──
# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web). Enable the Calendar and Gmail APIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/google/callback
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ── ML ──────────────────────────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SIMILARITY_REVIEW_THRESHOLD=0.75
SIMILARITY_RELATED_THRESHOLD=0.45       # calibrated on a labelled set — see docs/EVALUATION.md before changing
PRELOAD_EMBEDDING_MODEL=false           # true = load the model at startup instead of on the first originality check

LOG_LEVEL=INFO
LOG_JSON=true
