# Copy to .env and fill in for your environment. Never commit the real .env.

# SQLite by default (zero setup). For Postgres:
# DATABASE_URL=postgresql://nirmaan:nirmaan@localhost:5432/nirmaan
DATABASE_URL=sqlite:///./nirmaan.db

# Change this in any deployed environment — never use the dev default in production.
JWT_SECRET=dev-secret-change-in-production

# Comma-separated list of allowed frontend origins. Defaults to "*" (dev only);
# the app logs a warning and refuses to treat "*" as safe for production.
CORS_ORIGINS=http://localhost:5173

# Optional — enables "Continue with Google" login and the separate Google
# Calendar connection. Without these, both are cleanly disabled (the frontend
# hides/disables the buttons rather than showing a broken flow) — see
# GET /api/auth/google/status and GET /api/integrations/google/calendar/status.
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client type: Web application). Redirect URI must exactly match
# GOOGLE_REDIRECT_URI below, registered in the Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Optional — Team Builder uses an in-memory networkx graph if unset.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Optional — Originality Checker falls back to TF-IDF embeddings if sentence-transformers
# isn't installed or model weights can't be downloaded (no internet access).
MODEL_NAME=all-MiniLM-L6-v2

# Optional — path to a persisted FAISS index. If unset, a fresh index is built in-memory
# from the current PriorIdea corpus on each originality check.
FAISS_INDEX_PATH=
